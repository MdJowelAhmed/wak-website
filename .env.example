# Backend API Configuration
# Base API URL without trailing slash (e.g. https://api.yourdomain.com/api/v1)
BASE_URL=https://api.yourdomain.com/api/v1

# Base URL for static assets/images (e.g. https://api.yourdomain.com/)
IMG_URL=https://api.yourdomain.com/

# WebSocket Server URL (e.g. https://api.yourdomain.com)
NEXT_PUBLIC_SOCKET_URL=https://api.yourdomain.com

# Google Maps JavaScript API Key (Must be restricted to authorized domains in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS=your_google_maps_api_key_here

